[Unit]
Description=Speaker Controller Daemon
After=NetworkManager.service systemd-hostnamed.service
Requires=NetworkManager.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/speakerctld
Environment="DATA_DIR=/data"
ExecStart=/usr/bin/speakerctld \
    -interface wlan0 \
    -port 80 \
    -data-dir /data \
    -factory-reset-input /dev/input/event0 \
    -factory-reset-hold 10s

Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=speakerctld

# Required for SWUpdate integration via CGO
Environment="SWUPDATE_SOCKET_CTRL_PATH=/tmp/sockinstctrl"
Environment="SWUPDATE_SOCKET_PROGRESS_PATH=/tmp/swupdateprog"

[Install]
WantedBy=multi-user.target
